pkg load image;

clear;
close all;
clc;

% Read satellite image
I = imread('Input_image.png');

% Display original satellite image
figure;
imshow(I);
title('Original Satellite Image');

% Convert to grayscale
G = rgb2gray(I);

Gd = double(G);

figure;
imshow(G);
title('Grayscale');

% Thresholding
T = 125;

S = uint8((Gd > T) * 255);

% Save thresholded image
imwrite(S, 'satellite_threshold.png');

% Read thresholded image
Sread = imread('satellite_threshold.png');

figure;
imshow(Sread);
title('Thresholded');

% 3x3 averaging filter
Sd = double(Sread);

[rows, cols] = size(Sd);

mask = ones(3,3);

s = zeros(rows, cols);

for i = 2:rows-1
    for j = 2:cols-1

        block = Sd(i-1:i+1, j-1:j+1);

        s(i,j) = sum(sum(block .* mask)) / 9;

    end
end

% Convert filtered image to uint8
S_filtered = uint8(min(max(s, 0), 255));

% Save smoothed image
imwrite(S_filtered, 'satellite_smoothed.png');

% Read smoothed image
Sread2 = imread('satellite_smoothed.png');

figure;
imshow(Sread2);
title('3x3 Averaged');

% Laplacian sharpening
Sd2 = double(Sread2);

R = zeros(rows, cols);

laplacian_mask = [0 1 0;
                  1 -4 1;
                  0 1 0];

for i = 2:rows-1
    for j = 2:cols-1

        block2 = Sd2(i-1:i+1, j-1:j+1);

        R(i,j) = sum(sum(block2 .* laplacian_mask));

    end
end

% Sharpen image
F = Sd2 - R;

F_final = uint8(min(max(F, 0), 255));

% Display all processing stages
figure;

subplot(2,2,1);
imshow(G);
title('Grayscale');

subplot(2,2,2);
imshow(Sread);
title('Thresholded');

subplot(2,2,3);
imshow(Sread2);
title('3x3 Averaged');

subplot(2,2,4);
imshow(F_final);
title('Laplacian Sharpened');

disp('Saved: satellite_threshold.png and satellite_smoothed.png');
